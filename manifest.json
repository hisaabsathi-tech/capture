{
  "manifest_version": 3,
  "name": "Hisaabsathi Capture",
  "short_name": "Hisaabsathi Capture",
  "version": "0.9.3",
  "description": "Real-time Ekart and Shree Maruti shipment capture for Hisaabsathi.",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "scripting"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;"
  },
  "host_permissions": [
    "https://app.elite.ekartlogistics.in/*",
    "https://bookings.innofulfill.com/*",
    "https://server.hisaabsathi.in/*",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Hisaabsathi Capture",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.elite.ekartlogistics.in/ship/forward*"
      ],
      "js": [
        "lib/common.js",
        "adapters/ekart.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://bookings.innofulfill.com/credit-booking*"
      ],
      "js": [
        "lib/common.js",
        "adapters/shree-maruti.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
